# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# WordPress blog snapshot (regenerated by scripts/fetch-blog-posts.mjs)
# kept in git: fallback for the blog when the database is unreachable
# /data/blog-posts.json

# build archives
*.zip

# Claude Code local worktrees/settings
/.claude/worktrees/
/.claude/settings.local.json

# Lead form secrets for Hostinger (upload next to public_html, never commit)
/deploy/emsphere-form-config.php
scripts/.media-map.json

# Landing pages kept local: their PHP files hold mail passwords
/META LANIDNG PAGES/
